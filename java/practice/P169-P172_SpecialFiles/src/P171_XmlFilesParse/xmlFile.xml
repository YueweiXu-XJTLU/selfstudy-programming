<?xml version="1.0" encoding="UTF-8" ?> <!--XML Declaration (XML抬头申明), must appear in 1st line of xml files-->
<!--Annotation Format-->

<users> <!--root tag: only ONE pair-->
    <user1 id="1" desc="the first user">
        <name>San.Zhang</name>
        <gender>M</gender>
    </user1>

    <user2 id="2">
        <name>Si.Li</name>
        <gender>F</gender>
        <!--
            to avoid conflicts of signs:
        -->

        <!-- Method1:
            &lt; -> <
            &gt; -> >
            &amp; -> &
            &apos; -> '
            &quot; -> "
        -->
        <data1>3 &gt; 2 &amp;&amp; 4 &lt; 5</data1>

        <!-- Method2:
            write as usual in CDATA Section (CD + Enter)
        -->
        <data2><![CDATA[
        3 < 4 && 9 > 8
        ]]></data2>

    </user2>
</users>
